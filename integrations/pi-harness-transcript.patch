+++ b/test/bridge-transcript.test.mjs
@@ -0,0 +1,148 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { readTranscript } from "../extensions/bridge.ts";
+
+const timestamp = "2026-09-24T12:00:00.000Z";
+
+function context(entries, branch = entries) {
+  return { sessionManager: {
+    buildContextEntries: () => entries,
+    getBranch: () => branch,
+  } };
+}
+
+test("transcript exports visible messages, tool calls, outputs, and safe images without hidden prompts", () => {
+  const imageData = Buffer.alloc(96 * 1024).toString("base64");
+  const entries = [
+    { id: "system_1", timestamp, type: "message", message: { role: "system", content: "private system prompt", timestamp: Date.parse(timestamp) } },
+    { id: "user_1", timestamp, type: "message", message: { role: "user", content: [{ type: "text", text: "Inspect this screenshot" }, { type: "image", mimeType: "image/png", data: imageData }], timestamp: Date.parse(timestamp) } },
+    { id: "assistant_1", timestamp, type: "message", message: { role: "assistant", content: [{ type: "thinking", thinking: "private hidden reasoning" }, { type: "text", text: "I will inspect it." }, { type: "toolCall", id: "call_1", name: "bash", arguments: { command: "pwd" } }], timestamp: Date.parse(timestamp) } },
+    { id: "tool_1", timestamp, type: "message", message: { role: "toolResult", toolCallId: "call_1", toolName: "bash", content: [{ type: "text", text: "tool output" }], isError: false, timestamp: Date.parse(timestamp) } },
+    { id: "custom_hidden", timestamp, type: "message", message: { role: "custom", customType: "internal", display: false, content: "must not appear", timestamp: Date.parse(timestamp) } },
+    { id: "custom_message_hidden", timestamp, type: "custom_message", customType: "internal-hidden", display: false, content: "hidden Pi custom message", details: { secret: "not for export" } },
+    { id: "custom_message_visible", timestamp, type: "custom_message", customType: "notice", display: true, content: "visible custom message", details: { secret: "not for export" } },
+    { id: "bash_1", timestamp, type: "message", message: { role: "bashExecution", command: "git status", output: "working tree", exitCode: 0, cancelled: false, truncated: false, fullOutputPath: "/tmp/private/full-output.log", timestamp: Date.parse(timestamp) } },
+    { id: "compact_1", timestamp, type: "compaction", summary: "Compaction summary includes hidden thoughts", firstKeptEntryId: "user_1", tokensBefore: 100 },
+    { id: "branch_summary_1", timestamp, type: "branch_summary", summary: "Branch summary includes hidden reasoning", fromId: "user_1" },
+    { id: "state_1", timestamp, type: "custom", customType: "worklist-session-snapshot", data: {} },
+  ];
+
+  const result = readTranscript(context(entries), undefined);
+  const encoded = JSON.stringify(result);
+  assert.deepEqual(result.messages.map((message) => message.role), ["user", "assistant", "toolResult", "custom", "bashExecution"]);
+  assert.equal(result.cursor, "state_1");
+  assert.equal(result.reset, true);
+  assert.equal(encoded.includes("private system prompt"), false);
+  assert.equal(encoded.includes("private hidden reasoning"), false);
+  assert.equal(encoded.includes("must not appear"), false);
+  assert.equal(encoded.includes("hidden Pi custom message"), false);
+  assert.equal(encoded.includes("Compaction summary includes hidden thoughts"), false);
+  assert.equal(encoded.includes("Branch summary includes hidden reasoning"), false);
+  assert.equal(encoded.includes("/tmp/private/full-output.log"), false);
+  assert.equal(encoded.includes("not for export"), false);
+  assert.ok(Buffer.byteLength(encoded) > 64 * 1024, "image transcript exercises the enlarged frame limit");
+  assert.equal(result.messages[0].content[1].data, imageData);
+  assert.deepEqual(JSON.parse(result.messages[1].content.find((block) => block.type === "toolCall").arguments), { command: "pwd" });
+  assert.equal(result.messages[2].content[0].text, "tool output");
+  assert.equal(result.messages[3].label, "notice");
+  assert.equal(result.messages[3].content[0].text, "visible custom message");
+  assert.equal(result.messages[4].command, "git status");
+  assert.equal(result.messages[4].exitCode, 0);
+  assert.equal(result.messages[4].cancelled, false);
+  assert.equal(result.messages[4].truncated, false);
+});
+
+test("transcript deltas advance by active-branch entry and reset for stale cursors", () => {
+  const entries = [
+    { id: "user_1", timestamp, type: "message", message: { role: "user", content: "first", timestamp: Date.parse(timestamp) } },
+    { id: "state_1", timestamp, type: "custom", customType: "extension-state", data: {} },
+    { id: "assistant_1", timestamp, type: "message", message: { role: "assistant", content: [{ type: "text", text: "second" }], timestamp: Date.parse(timestamp) } },
+  ];
+  const delta = readTranscript(context(entries), "user_1");
+  assert.equal(delta.reset, false);
+  assert.equal(delta.cursor, "assistant_1");
+  assert.deepEqual(delta.messages.map((message) => message.id), ["assistant_1"]);
+
+  const reset = readTranscript(context(entries), "old_branch_entry");
+  assert.equal(reset.reset, true);
+  assert.deepEqual(reset.messages.map((message) => message.id), ["user_1", "assistant_1"]);
+});
+
+test("transcript uses compaction-aware context entries and excludes summaries", () => {
+  const contextEntries = [
+    { id: "compaction_1", timestamp, type: "compaction", summary: "summary may contain hidden reasoning", firstKeptEntryId: "kept_user", tokensBefore: 100 },
+    { id: "kept_user", timestamp, type: "message", message: { role: "user", content: "kept conversation", timestamp: Date.parse(timestamp) } },
+    { id: "branch_summary_1", timestamp, type: "branch_summary", summary: "branch summary may contain hidden reasoning", fromId: "kept_user" },
+    { id: "kept_assistant", timestamp, type: "message", message: { role: "assistant", content: "kept answer", timestamp: Date.parse(timestamp) } },
+  ];
+  const fullBranch = [
+    { id: "superseded_user", timestamp, type: "message", message: { role: "user", content: "superseded before compaction", timestamp: Date.parse(timestamp) } },
+    ...contextEntries,
+  ];
+  const sessionContext = context(contextEntries, fullBranch);
+  const result = readTranscript(sessionContext, undefined);
+  const encoded = JSON.stringify(result);
+  assert.deepEqual(result.messages.map((message) => message.id), ["kept_user", "kept_assistant"]);
+  assert.equal(encoded.includes("superseded before compaction"), false);
+  assert.equal(encoded.includes("summary may contain hidden reasoning"), false);
+  assert.equal(encoded.includes("branch summary may contain hidden reasoning"), false);
+
+  const delta = readTranscript(sessionContext, "kept_user");
+  assert.equal(delta.reset, false);
+  assert.equal(delta.cursor, "kept_assistant");
+  assert.deepEqual(delta.messages.map((message) => message.id), ["kept_assistant"]);
+  const staleCursor = readTranscript(sessionContext, "superseded_user");
+  assert.equal(staleCursor.reset, true);
+  assert.deepEqual(staleCursor.messages.map((message) => message.id), ["kept_user", "kept_assistant"]);
+});
+
+test("initial transcript snapshots bound the result and prefer the most recent entries", () => {
+  const entries = Array.from({ length: 85 }, (_, index) => ({
+    id: `msg_${index}`,
+    timestamp,
+    type: "message",
+    message: { role: index % 2 === 0 ? "user" : "assistant", content: `message ${index}`, timestamp: Date.parse(timestamp) + index },
+  }));
+  const result = readTranscript(context(entries), undefined);
+  assert.equal(result.messages.length, 80);
+  assert.equal(result.messages[0].id, "msg_5");
+  assert.equal(result.messages.at(-1).id, "msg_84");
+  assert.equal(result.truncated, true);
+  assert.equal(result.cursor, "msg_84");
+});
+
+test("a huge single delta entry is truncated and advances the active-context cursor", () => {
+  const toolCalls = Array.from({ length: 120 }, (_, index) => ({
+    type: "toolCall",
+    id: `call_${index}`,
+    name: "oversized-tool",
+    arguments: { value: "x".repeat(60 * 1024) },
+  }));
+  const entries = [
+    { id: "delta_start", timestamp, type: "message", message: { role: "user", content: "start", timestamp: Date.parse(timestamp) } },
+    { id: "huge_delta", timestamp, type: "message", message: { role: "assistant", content: toolCalls, timestamp: Date.parse(timestamp) } },
+  ];
+
+  const delta = readTranscript(context(entries), "delta_start");
+  assert.equal(delta.reset, false);
+  assert.equal(delta.cursor, "huge_delta");
+  assert.equal(delta.more, false);
+  assert.equal(delta.truncated, true);
+  assert.deepEqual(delta.messages.map((message) => message.id), ["huge_delta"]);
+  assert.ok(Buffer.byteLength(JSON.stringify(delta.messages[0]), "utf8") <= 3 * 1024 * 1024);
+});
+
+test("bash execution exports safe status fields but never its full output path", () => {
+  const entries = [
+    { id: "bash_failed", timestamp, type: "message", message: { role: "bashExecution", command: "false", output: "failed", exitCode: 7, cancelled: false, truncated: false, fullOutputPath: "/private/nonzero.log", timestamp: Date.parse(timestamp) } },
+    { id: "bash_cancelled", timestamp, type: "message", message: { role: "bashExecution", command: "sleep 10", output: "", exitCode: undefined, cancelled: true, truncated: false, fullOutputPath: "/private/cancelled.log", timestamp: Date.parse(timestamp) + 1 } },
+    { id: "bash_truncated", timestamp, type: "message", message: { role: "bashExecution", command: "large-output", output: "partial output", exitCode: 0, cancelled: false, truncated: true, fullOutputPath: "/private/truncated.log", timestamp: Date.parse(timestamp) + 2 } },
+  ];
+  const result = readTranscript(context(entries), undefined);
+  assert.deepEqual(result.messages.map(({ exitCode, cancelled, truncated }) => ({ exitCode, cancelled, truncated })), [
+    { exitCode: 7, cancelled: false, truncated: false },
+    { exitCode: undefined, cancelled: true, truncated: false },
+    { exitCode: 0, cancelled: false, truncated: true },
+  ]);
+  assert.equal(JSON.stringify(result).includes("/private/"), false);
+});
